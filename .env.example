# Kushlof creates a real .env with fresh secrets automatically on first start.
# This file only documents the available settings. Never put real secrets here.

# Encrypts AI provider API keys stored in the database (a Fernet key).
API_KEY_ENCRYPTION_SECRET=generated-automatically
# Used when hashing session tokens.
INTERNAL_SECRET_SALT=generated-automatically

# false = only this computer can open Kushlof (recommended).
# true  = allow other devices, e.g. your phone over Tailscale.
ALLOW_NETWORK_ACCESS=false

# The address the frontend is served from.
FRONTEND_ORIGIN=http://localhost:5173

# Set to true when Kushlof is served over HTTPS.
USE_SECURE_COOKIES=false
